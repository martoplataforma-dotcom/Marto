// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OutboxEvent {
  id          String       @id @default(uuid())
  aggregate   String
  aggregateId String
  type        String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  lastError   String?
  availableAt DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  processedAt DateTime?

  @@index([status, availableAt])
  @@index([aggregate, aggregateId])
  @@index([type])
}

model Transporter {
  id                String          @id @default(uuid())
  name              String
  type              TransporterType
  active            Boolean         @default(true)
  city              String?
  state             String?
  serviceArea       Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  serviceProviderId String          @unique
  shipments         Shipment[]
  rateTables        TransporterRateTable[]
  serviceProvider   ServiceProvider @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade)
}

model TransporterRateTable {
  id                  String        @id @default(uuid())
  transporterId       String
  active              Boolean       @default(true)

  originCepStart      String
  originCepEnd        String
  destinationCepStart String
  destinationCepEnd   String

  shippingClass       ShippingClass
  weightMinKg         Decimal       @db.Decimal(10, 3)
  weightMaxKg         Decimal       @db.Decimal(10, 3)

  priceCents          Int
  daysMin             Int
  daysMax             Int

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  transporter         Transporter   @relation(fields: [transporterId], references: [id], onDelete: Cascade)

  @@index([transporterId, active])
  @@index([originCepStart, originCepEnd])
  @@index([destinationCepStart, destinationCepEnd])
  @@index([shippingClass])
}

model Shipment {
  id            String             @id @default(uuid())
  orderId       String
  transporterId String?
  status        ShipmentStatus     @default(CREATED)
  quotedPrice   Int?
  estimatedDays Int?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  order         Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  proofs        DeliveryProof[]
  review        LogisticsReview?
  transporter   Transporter?       @relation(fields: [transporterId], references: [id])
  events        ShipmentEvent[]
  incidents     ShipmentIncident[]

  @@index([orderId])
  @@index([transporterId])
  @@index([status])
}

model ShipmentEvent {
  id          String         @id @default(uuid())
  shipmentId  String
  status      ShipmentStatus
  description String?
  createdAt   DateTime       @default(now())
  shipment    Shipment       @relation(fields: [shipmentId], references: [id])

  @@index([shipmentId])
  @@index([status])
}

model ShipmentIncident {
  id          String       @id @default(uuid())
  shipmentId  String
  type        IncidentType
  description String?
  createdAt   DateTime     @default(now())
  shipment    Shipment     @relation(fields: [shipmentId], references: [id])

  @@index([shipmentId])
  @@index([type])
}

model DeliveryProof {
  id         String   @id @default(uuid())
  shipmentId String
  type       PodType
  code       String?
  photoUrl   String?
  signedBy   String?
  createdAt  DateTime @default(now())
  shipment   Shipment @relation(fields: [shipmentId], references: [id])

  @@index([shipmentId])
}

model LogisticsReview {
  id         String          @id @default(uuid())
  shipmentId String          @unique
  rating     LogisticsRating
  comment    String?
  createdAt  DateTime        @default(now())
  shipment   Shipment        @relation(fields: [shipmentId], references: [id])
}

model SocialPost {
  id     String           @id @default(uuid())
  status SocialPostStatus @default(ACTIVE)

  userId           String
  orderId          String
  productId        String
  serviceRequestId String?

  caption   String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  comments SocialComment[]
  likes    SocialLike[]
  media    SocialMedia[]

  @@unique([userId, orderId, productId])
  @@index([userId, createdAt])
  @@index([productId, createdAt])
  @@index([orderId])
}

model SocialMedia {
  id          String          @id @default(uuid())
  postId      String
  type        SocialMediaType
  origin      MediaOrigin     @default(UPLOAD)
  url         String
  durationSec Int?
  createdAt   DateTime        @default(now())
  post        SocialPost      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([origin])
}

model SocialLike {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
  @@index([postId, createdAt])
}

model SocialComment {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([userId, createdAt])
}

model MartoFund {
  id        String   @id @default(uuid())
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  entries MartoFundEntry[]
}

model MartoFundEntry {
  id        String        @id @default(uuid())
  fundId    String
  type      FundEntryType
  amount    Decimal       @db.Decimal(14, 2)
  reason    String?
  refType   String?
  refId     String?
  createdAt DateTime      @default(now())

  fund MartoFund @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@index([type, createdAt])
  @@index([refType, refId])
  @@index([fundId, createdAt])
}

model PointsWallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions PointsTransaction[]
}

model PointsTransaction {
  id          String       @id @default(uuid())
  walletId    String
  type        PointsTxType
  amount      Int
  description String?
  refType     String?
  refId       String?
  createdAt   DateTime     @default(now())

  wallet PointsWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([type, createdAt])
  @@index([refType, refId])
}

model Mission {
  id                    String              @id @default(uuid())
  code                  String              @unique
  title                 String
  description           String?
  status                MissionStatus       @default(ACTIVE)
  rewardType            MissionRewardType   @default(POINTS)
  rewardValue           Int
  startsAt              DateTime?
  endsAt                DateTime?
  maxCompletionsPerUser Int?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  completions           MissionCompletion[]
}

model MissionCompletion {
  id        String   @id @default(uuid())
  missionId String
  userId    String
  refType   String?
  refId     String?
  createdAt DateTime @default(now())
  mission   Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([missionId, userId, refType, refId])
  @@index([userId, createdAt])
}

model FactoryChannel {
  id              String                @id @default(uuid())
  factoryId       String                @unique
  name            String
  description     String?
  catalogInfo     Json?
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  purchaseIntents PurchaseIntent[]
  relationships   RelationshipHistory[]

  @@index([factoryId])
}

model PurchaseIntent {
  id           String               @id @default(uuid())
  channelId    String
  companyName  String
  contactName  String
  contactEmail String?
  contactPhone String?
  productInfo  Json
  quantity     Int?
  frequency    String?
  notes        String?
  status       PurchaseIntentStatus @default(OPEN)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  channel      FactoryChannel       @relation(fields: [channelId], references: [id])
  relationship RelationshipHistory?

  @@index([channelId])
  @@index([status])
}

model RelationshipHistory {
  id               String             @id @default(uuid())
  channelId        String
  purchaseIntentId String?            @unique
  summary          String?
  internalNotes    String?
  status           RelationshipStatus @default(ACTIVE)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  channel          FactoryChannel     @relation(fields: [channelId], references: [id])
  purchaseIntent   PurchaseIntent?    @relation(fields: [purchaseIntentId], references: [id])

  @@index([channelId])
  @@index([status])
}

model Order {
  id         String      @id @default(uuid())
  merchantId String
  userId     String?
  buyerNameSnapshot          String?
  buyerContactSnapshot       Json?
  recipientNameSnapshot      String?
  destinationAddressSnapshot Json?
  status     OrderStatus @default(CREATED)
  destinationZipCode    String?
  selectedShippingMode  String?
  shippingPriceCents    Int?
  estimatedDays         Int?
  originZipCodeSnapshot String?

  // Timestamps de lifecycle (MVP)
  paidAt           DateTime?
  confirmedAt      DateTime?
  readyForPickupAt DateTime?
  inTransitAt      DateTime?
  deliveredAt      DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?

  // Pós-venda (MVP)
  returnRequestedAt DateTime?
  returnInTransitAt DateTime?
  returnedAt        DateTime?
  disputeAt         DateTime?

  city      String?
  state     String?
  reservedUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events OrderEvent[]
  items  OrderItem[]
  shipments       Shipment[]
  serviceRequests ServiceRequest[]
  serviceReviews ServiceReview[]
  externalOrderReferences ExternalOrderReference[]

  user        User?        @relation(fields: [userId], references: [id])
  socialPosts SocialPost[]

  @@index([merchantId, createdAt])
  @@index([status])
  @@index([reservedUntil])
}

model OrderEvent {
  id          String         @id @default(uuid())
  orderId     String
  type        OrderEventType @default(STATUS_CHANGED)
  actorUserId String?
  actorRole   String?
  fromStatus  OrderStatus?
  toStatus    OrderStatus?
  message     String?
  meta        Json?
  createdAt   DateTime       @default(now())
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([type, createdAt])
  @@index([toStatus, createdAt])
}

model OrderItem {
  id                String   @id @default(uuid())
  orderId           String
  productId         String?
  titleSnapshot     String?
  skuSnapshot       String?
  variationSnapshot Json?
  quantity          Int      @default(1)
  unitPrice         Decimal  @db.Decimal(12, 2)
  createdAt         DateTime @default(now())
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

model AnalyticsProductDaily {
  id            String   @id @default(uuid())
  date          DateTime
  productId     String
  merchantId    String
  region        String
  ordersCount   Int
  unitsSold     Int
  grossRevenue  Decimal  @db.Decimal(12, 2)
  avgPrice      Decimal  @db.Decimal(12, 2)
  reviewsCount  Int
  avgRating     Decimal? @db.Decimal(3, 2)
  logisticsCost Decimal? @db.Decimal(12, 2)
  serviceCost   Decimal? @db.Decimal(12, 2)
  margin        Decimal? @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  @@unique([date, productId, region])
  @@index([merchantId])
  @@index([date])
}

model ExportLog {
  id         String         @id @default(uuid())
  resource   ExportResource
  format     ExportFormat
  merchantId String?
  params     Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime       @default(now())

  @@index([resource, createdAt])
  @@index([merchantId, createdAt])
}

model Wallet {
  id        String        @id @default(uuid())
  type      WalletType
  ownerId   String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  ledger    LedgerEntry[]
  holds     WalletHold[]

  @@unique([type, ownerId])
}

model LedgerEntry {
  id          String          @id @default(uuid())
  walletId    String
  type        LedgerEntryType
  amount      Decimal         @db.Decimal(14, 2)
  description String
  reference   String?
  status      LedgerStatus    @default(POSTED)
  createdAt   DateTime        @default(now())
  wallet      Wallet          @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([reference])
  @@index([createdAt])
}

model WalletHold {
  id        String           @id @default(uuid())
  walletId  String
  amount    Decimal          @db.Decimal(14, 2)
  reason    String
  reference String
  status    WalletHoldStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  wallet    Wallet           @relation(fields: [walletId], references: [id])

  @@index([walletId, status])
  @@index([reference])
  @@index([createdAt])
}

model Anticipation {
  id         String             @id @default(uuid())
  merchantId String
  orderId    String?
  amount     Decimal            @db.Decimal(14, 2)
  fee        Decimal            @db.Decimal(14, 2)
  netAmount  Decimal            @db.Decimal(14, 2)
  status     AnticipationStatus @default(REQUESTED)
  reason     String?
  reference  String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([merchantId, createdAt])
  @@index([orderId])
  @@index([status])
}

model PixCharge {
  id         String          @id @default(uuid())
  receiver   String
  reference  String
  amount     Decimal         @db.Decimal(14, 2)
  status     PixChargeStatus @default(CREATED)
  provider   String?
  providerId String?
  brCode     String?
  qrCodeUrl  String?
  expiresAt  DateTime?
  paidAt     DateTime?
  payment    Payment?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  settledAt  DateTime?

  @@index([reference])
  @@index([status])
  @@index([provider, providerId])
  @@index([createdAt])
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  createdAt    DateTime @default(now())
  passwordHash String
  avatarUrl    String?
  bio          String?
  displayName  String?
  handle       String?  @unique
  activeRole   RoleCode?
  updatedAt    DateTime @updatedAt

  consumer        Consumer?
  factory         Factory?
  merchant        Merchant?
  representative  Representative?
  serviceProvider ServiceProvider?

  roles               UserRole[]
  passwordResetTokens PasswordResetToken[]

  // Orders (buyer)
  orders Order[]
  serviceRequests ServiceRequest[]
  serviceReviews ServiceReview[]

  // Social (conveniência)
  socialPosts    SocialPost[]
  socialLikes    SocialLike[]
  socialComments SocialComment[]

  // Points
  pointsWallet PointsWallet?

  // Payments
  paymentsMade     Payment[] @relation("UserPaymentsMade")
  payoutsToReceive Payout[]  @relation("UserPayoutsToReceive")
}

model Payment {
  id          String             @id @default(uuid())

  payerUserId String
  payerUser   User               @relation("UserPaymentsMade", fields: [payerUserId], references: [id])

  contextType PaymentContextType
  contextId   String

  // Mantemos Int em centavos para ledger/payout
  amountCents Int

  status      PaymentStatus      @default(authorized)

  // vínculo opcional com PixCharge (1:1)
  pixChargeId String?            @unique
  pixCharge   PixCharge?         @relation(fields: [pixChargeId], references: [id])

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  payouts     Payout[]

  @@index([payerUserId])
  @@index([contextType, contextId])
  @@index([status])
  @@index([createdAt])
}

model Payout {
  id          String             @id @default(uuid())

  paymentId   String
  payment     Payment            @relation(fields: [paymentId], references: [id])

  payeeUserId String
  payeeUser   User               @relation("UserPayoutsToReceive", fields: [payeeUserId], references: [id])

  contextType PaymentContextType
  contextId   String

  amountCents Int
  status      PayoutStatus       @default(held)

  releasedAt  DateTime?
  paidAt      DateTime?

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([paymentId])
  @@index([payeeUserId])
  @@index([contextType, contextId])
  @@index([status])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  role      RoleCode
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, role])
  @@index([userId])
}

model Merchant {
  id        String         @id @default(uuid())
  userId    String         @unique
  tradeName String
  document  String
  status    MerchantStatus @default(ACTIVE)
  originZipCode          String?
  supportsCorreios       Boolean @default(false)
  supportsTransportadora Boolean @default(false)
  supportsLocalDelivery  Boolean @default(false)
  supportsPickup         Boolean @default(false)

  handle   String? @unique // ex: "store5" (sem @ no banco)
  logoUrl  String?
  coverUrl String?

  createdAt DateTime @default(now())
  cepPrefix String?
  city      String?

  user     User      @relation(fields: [userId], references: [id])
  products Product[]
  salesChannels SalesChannel[]
}

model Product {
  id          String   @id @default(uuid())
  merchantId  String
  title       String
  description String?
  priceCents  Int
  active      Boolean  @default(true)
  requiresShipping    Boolean @default(true)
  productType         String?
  weightGrams         Int?
  lengthCm            Int?
  widthCm             Int?
  heightCm            Int?
  allowCorreios       Boolean @default(false)
  allowTransportadora Boolean @default(false)
  allowLocalDelivery  Boolean @default(false)
  allowPickup         Boolean @default(false)
  images      Json?
  // Legendas associadas às imagens. Deve ter o mesmo número de itens que `images`.
  imageCaptions String[] @default([])
  // B+C: insights por imagem (overview + hotspots com x/y em %)
  imageInsights Json?
  meta        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  merchant    Merchant     @relation(fields: [merchantId], references: [id])
  socialPosts SocialPost[]
  serviceLinks ProductServiceLink[]

  @@index([merchantId])
  @@index([active])
}

model ProductServiceLink {
  id          String   @id @default(uuid())
  productId   String
  serviceType String
  isRequired  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([serviceType])
  @@unique([productId, serviceType])
}

model ServiceProvider {
  id           String                @id @default(uuid())
  userId       String                @unique
  cpf          String
  city         String?
  cepPrefix    String?
  status       ServiceProviderStatus @default(ACTIVE)
  createdAt    DateTime              @default(now())
  kind         ServiceProviderKind   @default(GENERIC)
  address      Json?
  cep          String?
  document     String?
  documentType DocumentType?
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transporter  Transporter?
  serviceRequests ServiceRequest[]
  serviceReviews ServiceReview[]

  specialties String[] @default([])
}

model ServiceRequest {
  id              String               @id @default(uuid())
  orderId         String
  userId          String
  providerId      String?
  serviceType     String
  linkedProductId String?
  title           String
  notes           String?
  status          ServiceRequestStatus @default(REQUESTED)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  completedAt     DateTime?
  serviceReview   ServiceReview?

  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        ServiceProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([userId])
  @@index([providerId])
  @@index([serviceType])
  @@index([status])
}

model ServiceReview {
  id               String   @id @default(uuid())
  serviceRequestId String   @unique
  orderId          String
  userId           String
  providerId       String
  rating           Int
  comment          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  serviceRequest ServiceRequest  @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([userId])
  @@index([providerId])
  @@index([rating])
}

model Consumer {
  id        String         @id @default(uuid())
  userId    String         @unique
  city      String?
  cepPrefix String?
  status    ConsumerStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Representative {
  id         String               @id @default(uuid())
  userId     String               @unique
  region     String
  inviteCode String?
  status     RepresentativeStatus @default(ACTIVE)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Factory {
  id        String        @id @default(uuid())
  userId    String        @unique
  tradeName String
  legalName String?
  document  String
  city      String?
  state     String?
  status    FactoryStatus @default(ACTIVE)
  originZipCode          String?
  supportsCorreios       Boolean @default(false)
  supportsTransportadora Boolean @default(false)
  supportsLocalDelivery  Boolean @default(false)
  supportsPickup         Boolean @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum OrderEventType {
  STATUS_CHANGED
  NOTE
  FREIGHT_QUOTED
  FREIGHT_SELECTED
  PICKUP_REQUESTED
  PICKUP_CONFIRMED
  DELIVERED_CONFIRMED
  RETURN_REQUESTED
  RETURN_APPROVED
  RETURN_REJECTED
  DISPUTE_OPENED
  DISPUTE_RESOLVED
}

enum ServiceProviderKind {
  GENERIC
  DELIVERY
  TRANSPORTER
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum TransporterType {
  CARRIER
  LOCAL_COURIER
  STORE_PICKUP
}

enum ShipmentStatus {
  CREATED
  QUOTED
  CONFIRMED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

enum ShippingClass {
  SMALL
  MEDIUM
  LARGE
  BULKY
}

enum IncidentType {
  DELAY
  DAMAGE
  LOSS
  INVALID_ADDRESS
  OTHER
}

enum PodType {
  CODE
  PHOTO
  SIGNATURE
}

enum LogisticsRating {
  ONE
  TWO
  THREE
  FOUR
  FIVE
}

enum SocialMediaType {
  IMAGE
  VIDEO
}

enum MediaOrigin {
  UPLOAD
  EXTERNAL
}

enum SocialPostStatus {
  ACTIVE
  DELETED
}

enum FundEntryType {
  PLATFORM_FEE
  BREAKAGE
  PARTNER_INCENTIVE
  MANUAL_ADJUSTMENT
}

enum PointsTxType {
  EARN_PURCHASE
  EARN_REVIEW
  EARN_REFERRAL
  EARN_MISSION
  SPEND_CASHBACK
