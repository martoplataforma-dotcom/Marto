model PublicLink {
  id          String      @id @default(cuid())
  code        String      @unique
  kind        String      // MVP: "SHOP" etc
  targetPath  String      // ex: "/@store5"
  ownerUserId String?     // opcional
  createdAt   DateTime    @default(now())
  scans       PublicScan[]
}

model PublicScan {
  id        String     @id @default(cuid())
  linkId    String
  link      PublicLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  userAgent String?
  referer   String?
  ipHash    String?
}

enum SalesChannelType {
  MARTO
  MERCADO_LIVRE
  SHOPEE
  SITE
  AMAZON
  MAGALU
  OTHER
}

enum SalesChannelStatus {
  ACTIVE
  DISCONNECTED
  PAUSED
  ERROR
}

model SalesChannel {
  id                String             @id @default(uuid())
  merchantId        String
  type              SalesChannelType
  name              String
  externalAccountId String
  status            SalesChannelStatus @default(ACTIVE)
  lastSyncedAt      DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  merchant       Merchant                 @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  externalOrders ExternalOrderReference[]

  @@unique([merchantId, type, externalAccountId])
  @@index([merchantId, status])
  @@index([type, status])
}

model ExternalOrderReference {
  id                String   @id @default(uuid())
  orderId           String
  salesChannelId    String
  externalOrderId   String
  externalStatus    String?
  externalCreatedAt DateTime?
  externalUpdatedAt DateTime?
  lastSyncedAt      DateTime?
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  salesChannel SalesChannel @relation(fields: [salesChannelId], references: [id], onDelete: Restrict)

  @@unique([salesChannelId, externalOrderId])
  @@index([orderId])
  @@index([salesChannelId, lastSyncedAt])
  @@index([externalStatus])
}
