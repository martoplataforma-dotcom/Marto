DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marto?schema=public"
JWT_SECRET=supersecret
JWT_EXPIRES_IN=15m
REDIS_HOST=localhost
REDIS_PORT=6379

# Mercado Livre - runtime configuration
# Safe default: keep disabled until Mercado Livre application credentials exist.
MARTO_MERCADO_LIVRE_ENABLED=false
MARTO_MERCADO_LIVRE_CLIENT_ID=REPLACE_WITH_ML_CLIENT_ID
MARTO_MERCADO_LIVRE_CLIENT_SECRET=REPLACE_WITH_ML_CLIENT_SECRET
MARTO_MERCADO_LIVRE_REFRESH_SAFETY_WINDOW_MS=300000
MARTO_MERCADO_LIVRE_TRANSIENT_RETRY_DELAY_MS=60000
MARTO_MERCADO_LIVRE_REFRESH_STALE_AFTER_MS=120000
# Generate a private 32-byte Base64 key before enabling the integration.
MARTO_CREDENTIAL_ENCRYPTION_CURRENT_KEY_VERSION=local-v1
MARTO_CREDENTIAL_ENCRYPTION_KEYS={"local-v1":"REPLACE_WITH_32_BYTE_BASE64_KEY"}
